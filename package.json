{
  "name": "llm101n-ai-implementation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-only LLM101n Storyteller course — interactive chapters, local labs, search-engine AI assist (no backend).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.js",
    "archify:install": "bash scripts/install-archify-skill.sh",
    "architecture:deliver": "bash scripts/architecture-deliver.sh",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:prereq": "node scripts/capture-prereq-screenshots.mjs",
    "screenshots:lab": "node scripts/capture-lab-layout-screenshots.mjs",
    "screenshots:mobile": "node scripts/capture-mobile-screenshots.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "mermaid": "^11.6.0",
    "monaco-editor": "^0.52.2",
    "pyodide": "^0.27.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "playwright": "^1.63.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
